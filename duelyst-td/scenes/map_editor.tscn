[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/map_editor.gd" id="1_me"]

[node name="MapEditor" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_me")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.06, 0.06, 0.09, 1)
mouse_filter = 2

[node name="Root" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 18.0
offset_right = -24.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="TopBar" type="HBoxContainer" parent="Root"]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Root/TopBar"]
text = "Map Editor"
theme_override_font_sizes/font_size = 22

[node name="Spacer" type="Control" parent="Root/TopBar"]
size_flags_horizontal = 3

[node name="FilenameLabel" type="Label" parent="Root/TopBar"]
text = "Name:"

[node name="FilenameField" type="LineEdit" parent="Root/TopBar"]
custom_minimum_size = Vector2(180, 0)
placeholder_text = "my-map"

[node name="NewBtn" type="Button" parent="Root/TopBar"]
text = "New Blank"

[node name="LoadOption" type="OptionButton" parent="Root/TopBar"]
custom_minimum_size = Vector2(160, 0)

[node name="LoadBtn" type="Button" parent="Root/TopBar"]
text = "Load"

[node name="SaveBtn" type="Button" parent="Root/TopBar"]
text = "Save"

[node name="ValidateBtn" type="Button" parent="Root/TopBar"]
text = "Validate"

[node name="TestPlayBtn" type="Button" parent="Root/TopBar"]
text = "Test Play"

[node name="BackBtn" type="Button" parent="Root/TopBar"]
text = "Back"

[node name="PaletteBar" type="HBoxContainer" parent="Root"]
theme_override_constants/separation = 6

[node name="PaletteLabel" type="Label" parent="Root/PaletteBar"]
text = "Paint:"

[node name="PaletteB" type="Button" parent="Root/PaletteBar"]
text = "B  Buildable"
toggle_mode = true
custom_minimum_size = Vector2(120, 0)

[node name="PaletteP" type="Button" parent="Root/PaletteBar"]
text = "P  Path"
toggle_mode = true
custom_minimum_size = Vector2(100, 0)

[node name="PaletteX" type="Button" parent="Root/PaletteBar"]
text = "X  Blocked"
toggle_mode = true
custom_minimum_size = Vector2(110, 0)

[node name="PaletteS" type="Button" parent="Root/PaletteBar"]
text = "S  Spawn"
toggle_mode = true
custom_minimum_size = Vector2(100, 0)

[node name="PaletteC" type="Button" parent="Root/PaletteBar"]
text = "C  Core"
toggle_mode = true
custom_minimum_size = Vector2(100, 0)

[node name="PaletteSpacer" type="Control" parent="Root/PaletteBar"]
size_flags_horizontal = 3

[node name="HelpLabel" type="Label" parent="Root/PaletteBar"]
text = "Pick a tile type, then click cells. Drag to paint."
theme_override_font_sizes/font_size = 11
modulate = Color(0.75, 0.75, 0.82, 1)

[node name="GridFrame" type="PanelContainer" parent="Root"]
size_flags_vertical = 3

[node name="GridCenter" type="CenterContainer" parent="Root/GridFrame"]

[node name="Grid" type="GridContainer" parent="Root/GridFrame/GridCenter"]
columns = 20
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2

[node name="StatusLabel" type="RichTextLabel" parent="Root"]
bbcode_enabled = true
fit_content = true
scroll_active = false
custom_minimum_size = Vector2(0, 44)
text = "[i]Start by picking a tile type, then click to paint. Use Validate before Test Play.[/i]"
